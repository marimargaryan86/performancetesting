{
  "development": {
    "variables": {
      "count": 1,
      "traefik_entrypoints": "websecure",
      "traefik_host_URL": "webhooks.pay.junction.dev",
      "traefik_headers_accesscontrolalloworiginlist": "*",
      "traefik_headers_accessControlAllowHeaders": "*"
    }
  },
  "production": {
    "deploy": false,
    "variables": {
      "count": 2,
      "traefik_entrypoints": "web",
      "traefik_host_URL": "webhooks.pay.junction.travel",
      "traefik_headers_accesscontrolalloworiginlist": "https://webhooks.pay.junction.travel",
      "traefik_headers_accessControlAllowHeaders": "*"
    }
  },
  "sandbox": {
    "deploy": false,
    "variables": {
      "count": 1,
      "traefik_entrypoints": "websecure",
      "traefik_host_URL": "webhooks.pay.sandbox.junction.dev",
      "traefik_headers_accesscontrolalloworiginlist": "*",
      "traefik_headers_accessControlAllowHeaders": "*"
    }
  }
}
