                                        <s:enumeration value="End"/>
                                        <s:enumeration value="Rollback"/>
                                        <s:enumeration value="InSeries"/>
                                        <s:enumeration value="Continuation"/>
                                        <s:enumeration value="Subsequent"/>
                                    </s:restriction>
                                </s:simpleType>
                            </s:attribute>
                            <s:attribute name="RetransmissionIndicator" type="s:boolean"/>
                        </s:extension>
                    </s:complexContent>
                </s:complexType>
            </s:element>
            <s:complexType name="ArrayOfWarningType">
                <s:sequence>
                    <s:element minOccurs="0" maxOccurs="unbounded" name="Warning" type="tns:WarningType"/>
