                    <s:element minOccurs="0" maxOccurs="1" name="LocationDetail" type="tns:VehicleLocationDetailsType"/>
                    <s:element minOccurs="0" maxOccurs="unbounded" name="VehLocSearchCriterion" type="tns:ItemSearchCriterionType"/>
                </s:sequence>
                <s:attribute name="AlternateLocInd" type="s:boolean"/>
            </s:complexType>
