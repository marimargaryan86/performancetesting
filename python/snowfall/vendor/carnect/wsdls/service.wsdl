                    </s:extension>
                </s:simpleContent>
            </s:complexType>
            <s:complexType name="FreeTextType">
                <s:simpleContent>
                    <s:extension base="s:string">
                        <s:attribute name="Language" type="s:language"/>
                    </s:extension>
                </s:simpleContent>
            </s:complexType>
            <s:complexType name="WarningType">
                <s:simpleContent>
                    <s:extension base="tns:FreeTextType">
                        <s:attribute name="Type" type="s:string"/>
