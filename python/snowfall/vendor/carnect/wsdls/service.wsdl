                    <s:element minOccurs="0" maxOccurs="unbounded" name="VehMatchedLoc" type="tns:VehicleMatchedLocationType"/>
                </s:sequence>
            </s:complexType>
            <s:complexType name="VehicleMatchedLocationType">
