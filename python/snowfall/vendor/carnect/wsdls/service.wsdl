                        <s:attribute name="Code" type="s:string"/>
                        <s:attribute name="DocURL" type="s:anyURI"/>
                        <s:attribute name="Status" type="s:string"/>
                        <s:attribute name="Tag" type="s:string"/>
                        <s:attribute name="RecordID" type="s:string"/>
                    </s:extension>
                </s:simpleContent>
            </s:complexType>
            <s:complexType name="SuccessType"/>
            <s:element name="informationHeader" type="tns:InformationHeader"/>
            <s:complexType name="InformationHeader">
                <s:sequence>
                    <s:element minOccurs="1" maxOccurs="1" name="Successfully" type="s:boolean"/>
                    <s:element minOccurs="1" maxOccurs="1" name="ProcessingTime" type="s:double"/>
                </s:sequence>
                <s:anyAttribute/>
            </s:complexType>
            <s:element name="VehLocationSearchRQ">
