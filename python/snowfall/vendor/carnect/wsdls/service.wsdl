                <s:sequence>
                    <s:element minOccurs="0" maxOccurs="1" name="VehRentLocInfos" type="tns:ArrayOfVehicleLocationInformationType"/>
                    <s:element minOccurs="0" maxOccurs="1" name="ParkLocation" type="tns:VehicleWhereAtFacilityType"/>
                    <s:element minOccurs="0" maxOccurs="1" name="CounterLocation" type="tns:VehicleWhereAtFacilityType"/>
