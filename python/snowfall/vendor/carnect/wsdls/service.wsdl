            </s:complexType>
            <s:complexType name="FormattedTextType">
                <s:sequence>
                    <s:element minOccurs="0" maxOccurs="unbounded" name="SubSection" type="tns:FormattedTextSubSectionType"/>
                </s:sequence>
                <s:attribute name="Title" type="s:string"/>
