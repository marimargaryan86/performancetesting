<?xml version="1.0" encoding="utf-8"?>
<wsdl:definitions xmlns:s="http://www.w3.org/2001/XMLSchema" xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/" xmlns:http="http://schemas.xmlsoap.org/wsdl/http/" xmlns:mime="http://schemas.xmlsoap.org/wsdl/mime/" xmlns:tns="http://www.opentravel.org/OTA/2003/05" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tm="http://microsoft.com/wsdl/mime/textMatching/" xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" targetNamespace="http://www.opentravel.org/OTA/2003/05">
    <wsdl:types>
        <s:schema elementFormDefault="qualified" targetNamespace="http://www.opentravel.org/OTA/2003/05">
            <s:element name="PingRQ">
                <s:complexType>
                    <s:sequence>
                        <s:element minOccurs="0" maxOccurs="1" name="EchoData" type="s:string"/>
                    </s:sequence>
                    <s:attribute name="EchoToken" type="s:string"/>
                    <s:attribute name="TimeStamp" type="s:dateTime"/>
                    <s:attribute default="Production" name="Target">
                        <s:simpleType>
                            <s:restriction base="s:string">
                                <s:enumeration value="Test"/>
                                <s:enumeration value="Production"/>
                            </s:restriction>
                        </s:simpleType>
                    </s:attribute>
                    <s:attribute name="Version" type="s:decimal" use="required"/>
                    <s:attribute name="TransactionIdentifier" type="s:string"/>
                    <s:attribute name="SequenceNmbr" type="s:nonNegativeInteger"/>
                    <s:attribute name="TransactionStatusCode">
                        <s:simpleType>
                            <s:restriction base="s:string">
                                <s:enumeration value="Start"/>
                                <s:enumeration value="End"/>
                                <s:enumeration value="Rollback"/>
                                <s:enumeration value="InSeries"/>
                                <s:enumeration value="Continuation"/>
                                <s:enumeration value="Subsequent"/>
                            </s:restriction>
                        </s:simpleType>
                    </s:attribute>
                    <s:attribute name="RetransmissionIndicator" type="s:boolean"/>
                </s:complexType>
            </s:element>
            <s:element name="PingRS">
                <s:complexType>
                    <s:complexContent mixed="false">
                        <s:extension base="tns:OtaResponse">
                            <s:sequence>
                                <s:choice minOccurs="0" maxOccurs="unbounded">
                                    <s:element minOccurs="0" maxOccurs="1" name="EchoData" type="s:string"/>
                                    <s:element minOccurs="0" maxOccurs="1" name="Errors" type="tns:ErrorType"/>
                                    <s:element minOccurs="0" maxOccurs="1" name="Success" type="tns:SuccessType"/>
                                    <s:element minOccurs="0" maxOccurs="1" name="Warnings" type="tns:WarningType"/>
                                </s:choice>
                            </s:sequence>
                            <s:attribute name="EchoToken" type="s:string"/>
                            <s:attribute name="TimeStamp" type="s:dateTime"/>
                            <s:attribute default="Production" name="Target">
                                <s:simpleType>
                                    <s:restriction base="s:string">
                                        <s:enumeration value="Test"/>
                                        <s:enumeration value="Production"/>
                                    </s:restriction>
                                </s:simpleType>
                            </s:attribute>
                            <s:attribute name="Version" type="s:decimal" use="required"/>
                            <s:attribute name="TransactionIdentifier" type="s:string"/>
                            <s:attribute name="SequenceNmbr" type="s:nonNegativeInteger"/>
                            <s:attribute name="TransactionStatusCode">
                                <s:simpleType>
                                    <s:restriction base="s:string">
                                        <s:enumeration value="Start"/>
                                        <s:enumeration value="End"/>
                                        <s:enumeration value="Rollback"/>
                                        <s:enumeration value="InSeries"/>
                                        <s:enumeration value="Continuation"/>
                                        <s:enumeration value="Subsequent"/>
                                    </s:restriction>
                                </s:simpleType>
                            </s:attribute>
                            <s:attribute name="RetransmissionIndicator" type="s:boolean"/>
                        </s:extension>
                    </s:complexContent>
                </s:complexType>
            </s:element>
            <s:complexType name="OtaResponse" abstract="true"/>
            <s:complexType name="ErrorType">
                <s:simpleContent>
                    <s:extension base="tns:FreeTextType">
                        <s:attribute name="Type" type="s:string"/>
                        <s:attribute name="ShortText" type="s:string"/>
                        <s:attribute name="Code" type="s:string"/>
                        <s:attribute name="DocURL" type="s:anyURI"/>
                        <s:attribute name="Status" type="s:string"/>
                        <s:attribute name="Tag" type="s:string"/>
                        <s:attribute name="RecordID" type="s:string"/>
