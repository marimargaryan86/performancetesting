#: html_templates/booking_template.html:246
msgid "Booking confirmed"
msgstr "Reserva confirmada"

#: html_templates/booking_template.html:290
msgid "Booking: {reference}"
msgstr "Reserva: {reference}"

#: html_templates/booking_template.html:304
msgid "Thank you for booking with Snowfall!"
msgstr "¡Gracias por reservar con Snowfall!"

#: html_templates/booking_template.html:306
msgid ""
"Your booking ({reference}) has been confirmed - below are the complete "
"itinerary and ticket details."
msgstr ""
"Su reserva ({reference}) ha sido confirmada - a continuación se encuentran los detalles completos del itinerario y del boleto."

#: html_templates/booking_template.html:308
msgid "To download the tickets, click the button link below."
msgstr "Para descargar los boletos, haga clic en el enlace del botón a continuación."

#: html_templates/booking_template.html:311
msgid ""
"And, if you need any assistance, please <span style=\"color: #4bb69c; "
"line-height: 19.6px;\"><a rel=\"noopener\" "
"href=\"mailto:support@snowfalltravel.com\" target=\"_blank\" "
"style=\"color: #4bb69c;\">get in touch with our team</a></span>."
msgstr ""
"Y, si necesita ayuda, por favor <span style=\"color: #4bb69c; "
"line-height: 19.6px;\"><a rel=\"noopener\" "
"href=\"mailto:support@snowfalltravel.com\" target=\"_blank\" "
"style=\"color: #4bb69c;\">póngase en contacto con nuestro equipo</a></span>."

#: html_templates/booking_template.html:331
msgid "Download Tickets"
msgstr "Descargar boletos"

#: html_templates/booking_template.html:350
msgid "Itinerary details - booking {reference}"
msgstr "Detalles del itinerario - reserva {reference}"

