{
  "info": {
    "_postman_id": "79fe2eaa-8c82-4f31-80e6-c790d34d9aa4",
    "name": "Ory Auth/Token",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "33483058"
  },
  "item": [
    {
      "name": "Get Bearer Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json_data = pm.response.json();",
              "var bearer_token = json_data.access_token;",
              "pm.environment.set(\"bearer_token\", bearer_token);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic {{basic_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{ory_url}}",
          "host": [
            "{{ory_url}}"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "bearer_token",
      "value": ""
    }
  ]
}
