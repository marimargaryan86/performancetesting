{
  "packageManager": "yarn@4.1.0",
  "name": "@snowfall/fti-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
