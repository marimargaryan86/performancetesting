    "@sveltejs/kit": "^1.22.4",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/md5": "^2.3.2",
    "@types/mime-types": "^2.1.1",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "devalue": "^4.3.0",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-svelte": "^2.32.4",
    "jsonwebtoken": "^9.0.1",
    "jszip": "^3.10.1",
    "md5": "^2.3.0",
    "mime-types": "^2.1.35",
    "postcss-html": "^1.5.0",
