{
  "private": true,
  "packageManager": "yarn@4.2.1",
  "name": "@snowfall/hub-web",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test:unit-ui": "vitest --coverage.enabled=true --ui",
    "test:e2e": "playwright test --headed",
    "coverage": "vitest --coverage --run",
    "lint": "prettier --check . && eslint . && stylelint **/*.html **/*.svelte **/*.css",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@melt-ui/pp": "^0.3.0",
    "@melt-ui/svelte": "^0.79.0",
    "@playwright/test": "^1.41.2",
    "@snowfall/eslint-config": "workspace:configs/eslint",
    "@snowfall/prettier-config": "workspace:configs/prettier",
    "@snowfall/stylelint-config": "workspace:configs/stylelint",
    "@snowfall/tsconfig": "workspace:configs/tsconfig",
    "@snowfall/vitest-config": "workspace:configs/vitest",
    "@stripe/stripe-js": "^2.4.0",
    "@sveltejs/adapter-auto": "^3.2.0",
    "@sveltejs/adapter-node": "^5.0.1",
    "@sveltejs/kit": "^2.5.3",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/md5": "^2.3.5",
    "@types/mime-types": "^2.1.4",
    "cookie": "^0.6.0",
    "devalue": "^4.3.2",
    "dotenv": "^16.4.3",
    "i18next": "^23.10.0",
    "js-base64": "^3.7.6",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "md5": "^2.3.0",
    "mime-types": "^2.1.35",
    "playwright": "^1.41.2",
    "postcss-html": "^1.6.0",
    "svelte": "^4.2.12",
    "svelte-check": "^3.7.1",
    "svelte-preprocess": "^5.1.3",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.6",
    "zod": "^3.22.4"
  },
  "type": "module",
  "dependencies": {
    "@sentry/sveltekit": "^7.100.1",
    "smartlook-client": "^8.3.0"
  }
}
