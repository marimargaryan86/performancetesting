    "stylelint": "^15.2.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recommended": "^10.0.1",
    "stylelint-config-standard": "^30.0.1",
    "stylelint-order": "^6.0.2",
    "svelte": "^4.0.0",
    "svelte-check": "^3.4.3",
    "svelte-preprocess": "^5.0.4",
    "tslib": "^2.4.1",
    "typescript": "^5.1.6",
    "vite": "^4.0.0",
    "vitest": "^0.25.3",
    "zod": "^3.21.4"
