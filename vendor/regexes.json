{
  "required_matches": {
    "all_python_files": [
      "no_file_level_flake8_noqa",
      "no_file_level_mypy",
      "no_file_level_ruff_noqa",
      "no_file_level_type_ignore",
      "no_no_type_check_decorator",
      "no_pytest_mark_asyncio"
    ],
    "documentation_files": [
      "allowed_filename"
    ],
    "invalid_pytest_files": [
      "allowed_filename"
    ]
  },
  "path_patterns": [
    {
      "name": "all_python_files",
      "pattern": ".+\\.py$"
    },
    {
      "name": "documentation_files",
      "pattern": "^docs\\/.+\\/docs\\/([\\/]?.+_.+)\\.md$"
    },
    {
      "name": "invalid_pytest_files",
      "pattern": "test_[^\\/]+\\.py$"
    }
  ],
  "content_patterns": [
    {
      "name": "allowed_filename",
      "pattern": ".*",
      "inverted": true
    },
    {
      "name": "no_file_level_flake8_noqa",
      "pattern": "# flake8: noqa",
      "inverted": true
    },
    {
      "name": "no_file_level_mypy",
      "pattern": "# mypy: ",
      "inverted": true
    },
    {
      "name": "no_file_level_ruff_noqa",
      "pattern": "# ruff: noqa",
      "inverted": true
    },
    {
      "name": "no_file_level_type_ignore",
      "pattern": "^# type: ignore",
      "inverted": true
    },
    {
      "name": "no_infer_dep_ignore",
      "pattern": "# pants: no-infer-dep",
      "inverted": true
    },
    {
      "name": "no_no_type_check_decorator",
      "pattern": "@typing\\.no_type_check",
      "inverted": true
    },
    {
      "name": "no_pytest_mark_asyncio",
      "pattern": "@pytest\\.mark\\.asyncio",
      "inverted": true
    }
  ]
}
