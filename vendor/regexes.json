{
  "required_matches": {
    "all_python_files": [
      "no_file_level_flake8_noqa",
      "no_unspecific_type_ignore",
      "no_pytest_mark_asyncio"
    ]
  },
  "path_patterns": [
    {
      "name": "all_python_files",
      "pattern": ".*\\.py$"
    }
  ],
  "content_patterns": [
    {
      "name": "no_file_level_flake8_noqa",
      "pattern": "# flake8: noqa",
      "inverted": true
    },
    {
      "name": "no_unspecific_type_ignore",
      "pattern": "# type: ignore\\s",
      "inverted": true
    },
    {
      "name": "no_pytest_mark_asyncio",
      "pattern": "@pytest\\.mark\\.asyncio",
      "inverted": true
    }
  ]
}
