{
  "required_matches": {
    "all_python_files": [
      "no_file_level_flake8_noqa",
      "no_file_level_mypy",
      "no_file_level_ruff_noqa",
      "no_pytest_mark_asyncio"
    ]
  },
  "path_patterns": [
    {
      "name": "all_python_files",
      "pattern": ".*\\.py$"
    }
  ],
  "content_patterns": [
    {
      "name": "no_file_level_flake8_noqa",
      "pattern": "# flake8: noqa",
      "inverted": true
    },
    {
      "name": "no_file_level_mypy",
      "pattern": "# mypy: ",
      "inverted": true
    },
    {
      "name": "no_file_level_ruff_noqa",
      "pattern": "# ruff: noqa",
      "inverted": true
    },
    {
      "name": "no_infer_dep_ignore",
      "pattern": "# pants: no-infer-dep",
      "inverted": true
    },
    {
      "name": "no_pytest_mark_asyncio",
      "pattern": "@pytest\\.mark\\.asyncio",
      "inverted": true
    }
  ]
}
