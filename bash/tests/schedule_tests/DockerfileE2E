# development Runner for Schedule e2e tests
# To run locally:
# docker build -f golang/cmd/planner/Dockerfile . -t e2e-runner
# docker run --name e2e --rm --mount type=bind,source="$(pwd)",target="/junction"  -it e2e-runner
# Note it gets the source from the mount - prod build will be quite different
# replace mount with copy later

FROM ubuntu:20.04

ENV DEBIAN_FRONTEND noninteractive

RUN echo "Etc/UTC" > /etc/timezone
RUN     apt-get update -y && \
        apt-get -y --no-install-recommends install \
        vim=2:8.1.2269-1ubuntu5.13 \
        jq=1.6-1ubuntu0.20.04.1 \
        wget=1.20.3-1ubuntu2 \
        curl=7.68.0-1ubuntu2.18 \
        git=1:2.25.1-1ubuntu3.10 \
        make=4.2.1-1.2 \
        gcc=4:9.3.0-1ubuntu2 \
        python3-pip=20.0.2-5ubuntu1.8 \
        python3-setuptools=45.2.0-1ubuntu0.1 \
        python-cffi=1.14.0-1build1 \
        python3-brotli=1.0.7-6ubuntu0.1 \
        libpango-1.0-0=1.44.7-2ubuntu4 \
        libharfbuzz0b=2.6.4-1ubuntu4.2 \
        libpangoft2-1.0-0=1.44.7-2ubuntu4\
        libc6-dev=2.31-0ubuntu9.9 \
        unzip=6.0-25ubuntu1.1 \
        software-properties-common=0.99.9.11 && \
        add-apt-repository ppa:deadsnakes/ppa && \
        apt-get -y --no-install-recommends install  python3.10=3.10.11-1+focal1  && \
        apt-get clean && \
        rm -rf /var/lib/apt/lists/*


# install Go
ENV GOPATH=$HOME/go
ENV PATH=$PATH:$GOPATH/bin:/usr/local/go/bin
ENV GOOS=linux
ENV GOARCH=arm64
# hadolint disable=DL3059
RUN wget -nv https://go.dev/dl/go1.20.1.linux-arm64.tar.gz && \
    rm -rf /usr/local/go && \
    tar -C /usr/local -xzf go1.20.1.linux-arm64.tar.gz && \
    rm go1.20.1.linux-arm64.tar.gz

# install MongoDB tools
# hadolint disable=DL3059
RUN wget -nv https://fastdl.mongodb.org/tools/db/mongodb-database-tools-ubuntu2004-arm64-100.6.1.deb && \
    apt-get install --no-install-recommends -y ./mongodb-database-tools-ubuntu2004-arm64-100.6.1.deb && \
    rm ./mongodb-database-tools-ubuntu2004-arm64-100.6.1.deb
# NB (really bene) Cannot install mongodb-database-tools on Debian on ARM64, see ./README.md

# Install Pants (no really, it is).
RUN wget -nv  https://static.pantsbuild.org/setup/pantsup.sh  && \
    bash pantsup.sh --bin-dir /usr/local/bin --version 0.5.4 && \
    rm -f pantsup.sh

WORKDIR /feeds
WORKDIR /logs

# hadolint disable=DL3059
RUN pip3 --no-cache-dir install --upgrade awscli==1.27.92 yq==3.1.1 weasyprint==58.1 && \
    echo "set -o vi" >> ~/.bashrc ; \
    echo "alias lt=\"ls -alt\"" >> ~/.bashrc

WORKDIR /junction/golang
COPY  golang/ ./
RUN  go mod download
COPY  dist/codegen/golang ./
COPY dist/codegen/protobuf/ ./protobuf/

WORKDIR /junction
COPY ./python ./python/
COPY ./bash ./bash/
COPY ./pants* ./
COPY ./vendor ./vendor/
# Cause pants to run `pants bootstrap`
RUN pants help

ARG VERSION="dev"
ENV VERSION $VERSION
LABEL vendor="Snowfall Limited"
LABEL com.snowfalltravel.version=$VERSION

ENTRYPOINT ["tail", "-f", "/dev/null"]

#CMD ["bash", "tests/schedule_tests/run_e2e_tests.sh"]
