{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "reviewersFromCodeOwners": true,
  "semanticCommitScope": null,
  "rebaseWhen": "conflicted",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/|\\.)Dockerfile$",
        "(^|/)Dockerfile\\.[^/]*$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)(?: (?:packageName|lookupName)=(?<packageName>.+?))?(?: versioning=(?<versioning>[a-z-]+?))?\\s(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+?)\\s"
      ]
    },
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)pants.toml$"
      ],
      "matchStrings": [
        "\\spants_version = \\\"(?<currentValue>.+?)\\\"\\s"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "pants",
      "packageNameTemplate": "pantsbuild/pants",
      "extractVersionTemplate": "^release_(?<version>.*)$"
    }
  ],
  "prHourlyLimit": 10,
  "html": {
    "fileMatch": ["\\.html?\\.jinja$"]
  },
  "packageRules": [
    {
      "matchFileNames": [
        "svelte/**"
      ],
      "semanticCommitScope": "svelte"
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "registryUrls": [
        "https://gitlab+deploy-token-124:kNkm3XvTkUiWo86sa5EW@git.snowfall.se/api/v4/projects/677/packages/pypi/simple"
      ]
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "postUpgradeTasks": {
        "commands": [
          "pants --no-pantsd generate-lockfiles --resolve=python-default"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchPackageNames": [
        "aiobotocore",
        "boto3",
        "boto3-stubs",
        "botocore",
        "botocore-stubs",
        "mypy-boto3-location",
        "types-aiobotocore",
        "types-aiobotocore-sqs"
      ],
      "groupName": "boto"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchPackageNames": [
        "grpcio",
        "grpcio-health-checking",
        "grpcio-reflection",
        "grpcio-status",
        "grpcio-testing"
      ],
      "groupName": "grpc"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchPackageNames": [
        "pydantic",
        "pydantic-core"
      ],
      "groupName": "pydantic"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "oasdiff"
      ],
      "allowedVersions": "<2.0"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchPackageNames": [
        "add-trailing-comma",
        "docformatter",
        "ruff"
      ],
      "postUpgradeTasks": {
        "commands": [
          "pants --no-pantsd generate-lockfiles --resolve=python-default",
          "pants --no-pantsd fix python/::"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "pants"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.?(?<prerelease>.+))?$",
      "ignoreUnstable": false
    }
  ]
}
