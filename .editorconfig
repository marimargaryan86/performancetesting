root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

[*.{cjs,js,svelte,ts}]
indent_size = 2

[*.css]
indent_size = 2

[{*.go,go.mod}]
indent_style = tab

[*.html]
indent_size = 2

[*.{bson,json}]
indent_size = 2

[*.nomad]
indent_size = 2

[.prettierrc]
indent_size = 2

[*.proto]
indent_size = 2

[*.py]
max_line_length = 88

[*.sh]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
