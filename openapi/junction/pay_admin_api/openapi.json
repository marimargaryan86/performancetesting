  "components": {
    "parameters": {
      "page-cursor": {
        "name": "page[cursor]",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "default": "",
          "example": "MTogIjEiIDI6ICJkODVhZGRmNGEzNjFmOTc0IiAzOiAiNGY2M2UwNTAwODNlODQzYSI"
        },
        "description": "Pagination cursor that defines your place in the list."
      },
      "page-limit": {
        "name": "page[limit]",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "example": 20
        },
        "description": "A limit on the number of objects to be returned, between 1 and 100."
      },
      "paymentId": {
        "name": "paymentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid",
          "example": "271f6d54-9e59-407e-a860-b0771d9e3d26"
        },
        "description": "payment id"
      }
    },
    "schemas": {
      "User": {
        "title": "User",
        "type": "object",
        "description": "User information",
        "required": [
          "id",
          "type",
          "attributes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "271f6d54-9e59-407e-a860-b0771d9e3d26",
            "format": "uuid",
            "readOnly": true
          },
          "type": {
            "type": "string",
            "enum": [
              "users"
            ],
            "example": "users"
          },
          "attributes": {
            "required": [
              "email",
              "password"
            ],
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "example": "example@example.com"
              },
              "password": {
                "type": "string",
                "format": "password",
                "example": "myPassword",
                "writeOnly": true
              }
            }
          }
        }
      },
      "Authentication": {
        "title": "Authentication",
        "type": "object",
        "required": [
          "id",
          "type",
          "attributes"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "user-tokens"
            ],
            "example": "user-tokens"
          },
          "id": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c",
            "readOnly": true
          },
          "attributes": {
            "type": "object",
            "required": [
              "email",
              "password"
            ],
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "example": "example@example.com",
                "writeOnly": true
              },
              "password": {
                "type": "string",
                "format": "password",
                "example": "myPassword",
                "writeOnly": true
              },
              "token": {
                "type": "string",
                "readOnly": true,
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
              }
            }
          }
        }
      },
      "ChangePassword": {
        "title": "ChangePassword",
        "required": [
          "id",
          "type",
          "attributes"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "users"
            ],
            "example": "users"
          },
          "id": {
            "type": "string",
            "example": "271f6d54-9e59-407e-a860-b0771d9e3d26",
            "format": "uuid",
            "readOnly": true
          },
          "attributes": {
            "required": [
              "password"
            ],
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "example": "example@example.com"
              },
              "password": {
                "type": "string",
                "description": "New password",
                "format": "password",
                "example": "myPassword",
                "writeOnly": true
              }
            }
          }
        }
      },
      "MoneyAmount": {
        "title": "Money amount",
        "type": "integer",
        "example": 1337,
        "description": "A positive integer representing an amount of currency defined in the currency's smallest unit. This means that for currencies that have minor units, like EUR, 1 euro would be represented as 100, indicating 100 cents."
      },
      "Payment": {
        "title": "Payment",
        "allOf": [
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "relationships",
              "attributes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "example": "271f6d54-9e59-407e-a860-b0771d9e3d26",
                "format": "uuid",
                "readOnly": true
              },
              "type": {
                "type": "string",
                "example": "payments",
                "enum": [
                  "payments"
                ]
              },
              "attributes": {
                "type": "object",
                "required": [
                  "reason",
                  "reference"
                ],
                "properties": {
                  "amount": {
                    "$ref": "#/components/schemas/MoneyAmount"
                  },
                  "reason": {
                    "type": "string",
                    "example": "This is a test payment",
                    "description": "Reason of the payment"
                  },
                  "reference": {
                    "type": "string",
                    "example": "This is a test reference",
                    "description": "Reference of the payment"
                  },
                  "paymentAt": {
                    "type": "string",
                    "format": "date",
                    "example": "2023-03-06",
                    "description": "when the payment will be paid"
                  },
                  "status": {
                    "type": "string",
                    "example": "ready-to-send",
                    "enum": [
                      "pending",
                      "ready-to-send",
                      "completed",
                      "failed"
                    ],
                    "readOnly": true
                  }
                }
              },
              "relationships": {
                "type": "object",
                "required": [
                  "beneficiary"
                ],
                "properties": {
                  "beneficiary": {
                    "type": "object",
                    "description": "Beneficiary, where payment should be credited",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/BeneficiaryIdentifier"
                      }
                    }
                  },
                  "transactions": {
                    "type": "object",
                    "description": "transactions list for make payment to beneficiary",
                    "properties": {
                      "data": {
                        "type": "array",
                        "uniqueItems": true,
                        "minimum": 0,
                        "items": {
                          "$ref": "#/components/schemas/TransactionIdentifier"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "$ref": "#/components/schemas/SelfLink"
          }
        ]
      },
      "BeneficiaryIdentifier": {
        "title": "Beneficiary Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "04f83af5-10bb-4a0f-1881-03e1e690f0f5",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "beneficiaries"
            ],
            "example": "beneficiaries"
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "TransactionIdentifier": {
        "title": "Transaction Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "04f83af5-10bb-4a0f-1881-03e1e690f0f5",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "transactions"
            ],
            "example": "transactions"
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "SelfLink": {
        "title": "Self Link",
        "type": "object",
        "properties": {
          "links": {
            "type": "object",
            "required": [
              "self"
            ],
            "properties": {
              "self": {
                "type": "string",
                "format": "uri",
                "example": "https://example.com/resource/04f83af9-90bb-4a0f-9881-03e1e690f7f5",
                "readOnly": true
              }
            },
            "readOnly": true
          }
        },
        "required": [
          "links"
        ]
      },
      "NextLink": {
        "title": "Next Link",
        "type": "object",
        "properties": {
          "links": {
            "type": "object",
            "required": [
              "next"
            ],
            "properties": {
              "next": {
                "type": "string",
                "format": "uri",
                "example": "https://example.com/resource/?page%5Bcursor%5D=MTogIjAwNGNjOTQ5LWQ4NjYtNWM1MS05MmYxLTRjMTUxYTA4YzBjOSIgMjogIjM0ZmQwZmUzMDRhYjY3ZmIiIDM6ICIyZjhiZDU3MDljMjI3Mjg0Ig%3D%3D&page%5Blimit%5D=20",
                "readOnly": true
              }
            },
            "readOnly": true
          }
        },
        "required": [
          "links"
        ]
      },
      "Error": {
        "title": "Error",
        "type": "object",
        "description": "JSON:API error",
        "properties": {
          "status": {
            "type": "string",
            "pattern": "^[45][0-9]{2}$",
            "description": "The HTTP status code applicable to this problem, expressed as a string value.",
            "example": "404"
          },
          "title": {
            "type": "string",
            "example": "Not Found",
            "description": "A short, human-readable summary of the problem that SHOULD NOT change from occurrence to occurrence of the problem, except for purposes of localization."
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence of the problem. Like `title`, this field’s value can be localized.",
            "example": "Nothing matches the given URI"
          },
          "code": {
            "type": "string",
            "example": "required",
            "description": "An application-specific error code, expressed as a string value."
          },
          "source": {
            "description": "An object containing references to the source of the error.",
            "properties": {
              "pointer": {
                "type": "string",
                "example": "/data/attributes/title",
                "description": "A JSON Pointer to the associated entity in the request document."
              },
              "parameter": {
                "type": "string",
                "example": "page[cursor]",
                "description": "A string indicating which URI query parameter caused the error."
              },
              "header": {
                "type": "string",
                "example": "X-Request-Id",
                "description": "A string indicating the name of a single request header which caused the error."
              }
            },
            "minProperties": 1,
            "maxProperties": 1,
            "type": "object"
          }
        },
        "required": [
          "status",
          "detail"
        ]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "required": [
                "errors"
              ]
            }
          }
        }
      },
      "BadRequest": {
        "description": "Bad Request",
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 1,
                  "items": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "required": [
                "errors"
              ]
            }
          }
        }
      },
      "NotFound": {
        "description": "Not Found",
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "required": [
                "errors"
              ]
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden request",
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "type": "object",
              "required": [
                "errors"
              ],
              "properties": {
                "errors": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
