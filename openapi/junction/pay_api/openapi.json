  "components": {
    "parameters": {
      "page-cursor": {
        "name": "page[cursor]",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "default": "1",
          "example": "1"
        },
        "description": "Pagination cursor that defines your place in the list."
      },
      "page-limit": {
        "name": "page[limit]",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "example": 20
        },
        "description": "A limit on the number of objects to be returned, between 1 and 100."
      },
      "sort": {
        "name": "order",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "example": "created"
        },
        "description": "Field name what should be used to order"
      },
      "currencyId": {
        "name": "currencyId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "currency",
          "example": "USD"
        },
        "description": "Currency id"
      },
      "companyId": {
        "name": "companyId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid",
          "example": "271f6d54-9e59-407e-a860-b0771d9e3d26"
        },
        "description": "Company id"
      }
    },
    "schemas": {
      "User": {
        "title": "User",
        "type": "object",
        "description": "User information",
        "required": [
          "attributes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "271f6d54-9e59-407e-a860-b0771d9e3d26",
            "format": "uuid",
            "readOnly": true
          },
          "type": {
            "type": "string",
            "enum": [
              "users"
            ],
            "example": "users"
          },
          "attributes": {
            "required": [
              "email",
              "password"
            ],
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "example": "example@example.com"
              },
              "password": {
                "type": "string",
                "format": "password",
                "example": "myPassword",
                "writeOnly": true
              }
            }
          }
        }
      },
      "Authentication": {
        "title": "Authentication",
        "type": "object",
        "required": [
          "attributes"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "user-tokens"
            ],
            "example": "user-tokens"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "271f6d54-9e59-407e-a860-b0771d9e3d26",
            "readOnly": true
          },
          "attributes": {
            "type": "object",
            "required": [
              "email",
              "password"
            ],
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "example": "example@example.com",
                "writeOnly": true
              },
              "password": {
                "type": "string",
                "format": "password",
                "example": "myPassword",
                "writeOnly": true
              },
              "token": {
                "type": "string",
                "readOnly": true,
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
              }
            }
          }
        }
      },
      "ChangePassword": {
        "title": "ChangePassword",
        "required": [
          "attributes"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "users"
            ],
            "example": "users"
          },
          "id": {
            "type": "string",
            "example": "271f6d54-9e59-407e-a860-b0771d9e3d26",
            "format": "uuid",
            "readOnly": true
          },
          "attributes": {
            "required": [
              "password"
            ],
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "example": "example@example.com"
              },
              "password": {
                "type": "string",
                "description": "New password",
                "format": "password",
                "example": "myPassword",
                "writeOnly": true
              }
            }
          }
        }
      },
      "Rate": {
        "title": "Rate",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "271f6d54-9e59-407e-a860-b0771d9e3d26",
                "format": "uuid",
                "readOnly": true
              },
              "type": {
                "type": "string",
                "example": "rates",
                "enum": [
                  "rates"
                ]
              },
              "attributes": {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "rate": {
                    "type": "number",
                    "format": "float",
                    "example": 1.02,
                    "readOnly": true
                  }
                },
                "required": [
                  "rate"
                ]
              },
              "relationships": {
                "type": "object",
                "required": [
                  "fromCurrency",
                  "toCurrency"
                ],
                "properties": {
                  "fromCurrency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  },
                  "toCurrency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "type",
              "attributes"
            ]
          }
        ],
        "description": "Rate schema."
      },
      "Quote": {
        "title": "Quote",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "271f6d54-9e59-407e-a860-b0771d9e3d26",
                "format": "uuid",
                "readOnly": true
              },
              "type": {
                "type": "string",
                "example": "quotes",
                "enum": [
                  "quotes"
                ]
              },
              "attributes": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number",
                    "example": 1000
                  }
                },
                "required": [
                  "amount"
                ]
              },
              "relationships": {
                "type": "object",
                "required": [
                  "fromCurrency",
                  "toCurrency",
                  "payer",
                  "beneficiary"
                ],
                "properties": {
                  "fromCurrency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  },
                  "payer": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CompanyIdentifier"
                      }
                    }
                  },
                  "beneficiary": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CompanyIdentifier"
                      }
                    }
                  },
                  "toCurrency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "type",
              "attributes"
            ]
          }
        ],
        "description": "Quote schema."
      },
      "Balance": {
        "title": "Balance",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5",
                "format": "uuid",
