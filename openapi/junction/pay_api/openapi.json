  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "tags": [
          "internal"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "description": "",
                  "type": "object",
                  "x-examples": {
                    "example-1": {
                      "meta": {
                        "status": "ok"
                      }
                    }
                  },
                  "properties": {
                    "meta": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "description": "Health status",
                          "enum": [
                            "pass",
                            "fail",
                            "warn"
                          ],
                          "example": "pass"
                        }
                      }
                    }
                  },
                  "required": [
                    "meta"
                  ]
                }
              }
            }
          }
        },
        "operationId": "get-health",
        "description": "Check the application health.",
        "x-internal": true,
        "security": []
      }
    },
    "/balances": {
      "get": {
        "summary": "List Balances",
        "tags": [
          "balances"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/page-cursor"
          },
          {
            "$ref": "#/components/parameters/page-limit"
          },
          {
            "$ref": "#/components/parameters/sort"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "allOf": [
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "uniqueItems": true,
                          "minItems": 0,
                          "items": {
                            "$ref": "#/components/schemas/Balance"
                          }
                        }
                      },
                      "required": [
                        "data"
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/NextLink"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "get-balances",
        "description": "Get account balances",
        "security": []
      }
    },
    "/currencies/{currencyId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/currencyId"
        }
      ],
      "get": {
        "summary": "Get Currency details",
        "tags": [
          "currencies"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Currency"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "get-currencies-id",
        "description": "Used to get currency details"
      }
    },
    "/rates": {
      "post": {
        "summary": "Create Rate",
        "tags": [
          "rates"
        ],
        "operationId": "post-rates",
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Rate"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "description": "Used to get rate between currencies",
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/Rate"
                  }
                },
                "required": [
                  "data"
                ]
              }
            }
          }
        }
      }
    },
    "/quotes": {
      "post": {
        "summary": "Create Quote",
        "tags": [
          "quotes"
        ],
        "operationId": "post-quotes",
        "responses": {
          "200": {
            "description": "Quoted",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Quote"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "description": "Used to get quote for exchanging currencies",
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/Quote"
                  }
                },
                "required": [
                  "data"
                ]
              }
            }
          }
        }
      }
    },
    "/transactions": {
      "post": {
        "summary": "Create transactions",
        "description": "Create transactions if quotation is valid",
        "tags": [
          "transactions"
        ],
        "operationId": "post-transactions",
        "responses": {
          "201": {
            "description": "Transaction is created",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Transaction"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/Transaction"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "page-cursor": {
        "name": "page[cursor]",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "default": "1",
          "example": "1"
        },
        "description": "Pagination cursor that defines your place in the list."
      },
      "page-limit": {
        "name": "page[limit]",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "example": 20
        },
        "description": "A limit on the number of objects to be returned, between 1 and 100."
      },
      "sort": {
        "name": "order",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "example": "created"
        },
        "description": "Field name what should be used to order"
      },
      "currencyId": {
        "name": "currencyId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "currency",
          "example": "USD"
        },
        "description": "Currency id"
      }
    },
    "schemas": {
      "Rate": {
        "title": "Rate",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "271f6d54-9e59-407e-a860-b0771d9e3d26",
                "format": "uuid",
                "readOnly": true
              },
              "type": {
                "type": "string",
                "example": "rates",
                "enum": [
                  "rates"
                ]
              },
              "attributes": {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "rate": {
                    "type": "number",
                    "format": "float",
                    "example": 1.02,
                    "readOnly": true
                  }
                },
                "required": [
                  "rate"
                ]
              },
              "relationships": {
                "type": "object",
                "required": [
                  "fromCurrency",
                  "toCurrency"
                ],
                "properties": {
                  "fromCurrency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  },
                  "toCurrency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "id",
              "type",
              "attributes"
            ]
          }
        ],
        "description": "Rate schema."
      },
      "Quote": {
        "title": "Quote",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "271f6d54-9e59-407e-a860-b0771d9e3d26",
                "format": "uuid",
                "readOnly": true
              },
              "type": {
                "type": "string",
                "example": "quotes",
                "enum": [
                  "quotes"
                ]
              },
              "attributes": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number",
                    "example": 1000
                  },
                  "externalReference": {
                    "type": "string",
                    "example": "FMSXrOAhIOdvIbxAmfSt7vJtRBkurNbn"
                  }
                },
                "required": [
                  "amount"
                ]
              },
              "relationships": {
                "type": "object",
                "required": [
                  "fromCurrency",
                  "toCurrency",
                  "payer",
                  "beneficiary"
                ],
                "properties": {
                  "fromCurrency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  },
                  "payer": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CompanyIdentifier"
                      }
                    }
                  },
                  "beneficiary": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CompanyIdentifier"
                      }
                    }
                  },
                  "toCurrency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "id",
              "type",
              "attributes"
            ]
          }
        ],
        "description": "Quote schema."
      },
      "Balance": {
        "title": "Balance",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5",
                "format": "uuid",
                "readOnly": true
              },
              "type": {
                "type": "string",
                "example": "balances",
                "enum": [
                  "balances"
                ]
              },
              "attributes": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "integer",
                    "example": 1000
                  }
                },
                "required": [
                  "amount"
                ]
              },
              "relationships": {
                "type": "object",
                "required": [
                  "currency"
                ],
                "properties": {
                  "currency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "id",
              "type",
              "attributes",
              "relationships"
            ]
          }
        ],
        "description": "Account Balances."
      },
      "Currency": {
        "title": "Currency",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "USD",
                "readOnly": true
              },
              "type": {
                "type": "string",
                "example": "currencies",
                "enum": [
                  "currencies"
                ]
              },
              "attributes": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "US Dollar"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "id",
              "type",
              "attributes"
            ]
          }
        ],
        "description": "Currency details."
      },
      "Money": {
        "title": "Money",
        "description": "Amount and currency.",
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "format": "currency",
            "example": "EUR"
          },
          "amount": {
            "type": "integer",
            "example": 1337
          }
        },
        "required": [
          "currency",
          "amount"
        ]
      },
      "Transaction": {
        "title": "Transaction",
        "type": "object",
        "description": "Transaction data",
        "required": [
          "id",
          "type",
          "attributes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5",
            "format": "uuid",
            "readOnly": true
          },
          "type": {
            "type": "string",
            "enum": [
              "transactions"
            ],
            "example": "transactions"
          },
          "attributes": {
            "required": [
              "externalReference",
              "parentExternalReference",
              "createdAt",
              "beneficiaryAmount",
              "offerAmount",
              "convertedBeneficiaryAmount",
              "bufferAmount",
              "salesAmount",
              "exchangeRate",
              "bufferRate",
              "salesRate"
            ],
            "properties": {
              "externalReference": {
                "type": "string",
                "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5",
                "format": "uuid"
              },
              "parentExternalReference": {
                "type": "string",
                "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5",
                "format": "uuid"
              },
              "createdAt": {
                "type": "string",
                "example": "2023-01-20T17:04:14+00:00",
                "format": "date-time",
                "readOnly": true
              },
              "beneficiaryAmount": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Money"
                  }
                ],
                "readOnly": true
              },
              "offerAmount": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Money"
                  }
                ],
                "readOnly": true
              },
              "convertedBeneficiaryAmount": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Money"
                  }
                ],
                "readOnly": true
              },
              "bufferAmount": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Money"
                  }
                ],
                "readOnly": true
              },
              "salesAmount": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Money"
                  }
                ],
                "readOnly": true
              },
              "exchangeRate": {
                "type": "number",
                "format": "float",
                "example": 1.02,
                "readOnly": true
              },
              "bufferRate": {
                "type": "number",
                "format": "float",
                "example": 1.02,
                "readOnly": true
              },
              "salesRate": {
                "type": "number",
                "format": "float",
                "example": 1.02,
                "readOnly": true
              }
            }
          },
          "relationships": {
            "required": [
              "quotation"
            ],
            "properties": {
              "quotation": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/QuotationIdentifier"
                  }
                },
                "writeOnly": true
              },
              "conversion": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/ConversionIdentifier"
                  }
                },
                "readOnly": true
              },
              "payer": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/CompanyIdentifier"
                  }
                },
                "readOnly": true
              },
              "beneficiary": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/CompanyIdentifier"
                  }
                },
                "readOnly": true
              }
            }
          }
        }
      },
      "CompanyIdentifier": {
        "title": "Company Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "04f83af5-10bb-4a0f-1881-03e1e690f0f5",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "companies"
            ],
            "example": "companies"
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "CurrencyIdentifier": {
        "title": "Currency Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "USD"
          },
          "type": {
            "type": "string",
            "enum": [
              "currencies"
            ],
            "example": "currencies"
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "QuotationIdentifier": {
        "title": "Quotation Identifier",
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5"
          },
          "type": {
            "type": "string",
            "enum": [
              "quotations"
            ],
            "example": "quotations"
          }
        }
      },
      "ConversionIdentifier": {
        "title": "Conversion Identifier",
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5"
          },
          "type": {
            "type": "string",
            "enum": [
              "conversions"
            ],
            "example": "conversions"
          }
        }
      },
      "NextLink": {
        "title": "Next Link",
        "type": "object",
        "properties": {
          "links": {
            "type": "object",
            "required": [
              "next"
            ],
            "properties": {
              "next": {
                "type": "string",
                "format": "uri",
                "example": "https://example.com/resource/?page%5Bcursor%5D=MTogIjAwNGNjOTQ5LWQ4NjYtNWM1MS05MmYxLTRjMTUxYTA4YzBjOSIgMjogIjM0ZmQwZmUzMDRhYjY3ZmIiIDM6ICIyZjhiZDU3MDljMjI3Mjg0Ig%3D%3D&page%5Blimit%5D=20",
                "readOnly": true
              }
            },
            "readOnly": true
          }
        },
        "required": [
          "links"
        ]
      },
      "Error": {
        "title": "Error",
        "type": "object",
        "description": "JSON:API error",
        "properties": {
          "status": {
            "type": "string",
            "pattern": "^[45][0-9]{2}$",
            "description": "The HTTP status code applicable to this problem, expressed as a string value.",
            "example": "404"
          },
          "title": {
            "type": "string",
            "example": "Not Found",
            "description": "A short, human-readable summary of the problem that SHOULD NOT change from occurrence to occurrence of the problem, except for purposes of localization."
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence of the problem. Like `title``, this field’s value can be localized.",
            "example": "Nothing matches the given URI"
          },
          "code": {
            "type": "string",
            "example": "required",
            "description": "An application-specific error code, expressed as a string value."
          },
          "source": {
            "type": "object",
