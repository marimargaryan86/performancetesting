      "email": "info@snowfalltravel.com"
    },
    "license": {
      "name": "Junction",
      "url": "https://www.snowfalltravel.com"
    }
  },
  "x-internal": true,
  "x-tagGroups": [
    {
      "name": "Internal",
      "tags": [
        "internal"
      ]
    },
    {
      "name": "Quotes",
      "tags": [
        "quotes"
      ]
    },
    {
      "name": "Rates",
      "tags": [
        "rates"
      ]
    },
    {
      "name": "Transactions",
      "tags": [
        "transactions"
      ]
    }
  ],
  "tags": [
    {
      "name": "internal",
      "description": "Endpoints not for public use.",
      "x-displayName": "Internal"
    },
    {
      "name": "quotes",
      "description": "Currency quotes",
      "x-displayName": "Quotes"
    },
    {
      "name": "rates",
      "description": "FX rates",
      "x-displayName": "Rates"
    },
    {
      "name": "transactions",
      "description": "Account transactions",
      "x-displayName": "Transactions"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "tags": [
          "internal"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "description": "",
                  "type": "object",
                  "x-examples": {
                    "example-1": {
                      "meta": {
                        "status": "ok"
                      }
                    }
                  },
                  "properties": {
                    "meta": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "description": "Health status",
                          "enum": [
                            "pass",
                            "fail",
                            "warn"
                          ],
                          "example": "pass"
                        }
                      }
                    }
                  },
                  "required": [
                    "meta"
                  ]
                }
              }
            }
          }
        },
        "operationId": "get-health",
        "description": "Check the application health.",
        "x-internal": true,
        "security": []
      }
    },
    "/rates": {
      "post": {
        "summary": "Create Rate",
        "tags": [
          "rates"
        ],
        "operationId": "post-rates",
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Rate"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "description": "Used to get rate between currencies",
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/Rate"
                  }
                },
                "required": [
                  "data"
                ]
              }
            }
          }
        }
      }
    },
    "/quotes": {
      "post": {
        "summary": "Create Quote",
        "tags": [
          "quotes"
        ],
        "operationId": "post-quotes",
        "responses": {
          "200": {
            "description": "Quoted",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Quote"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "description": "Used to get quote for exchanging currencies",
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/Quote"
                  }
                },
                "required": [
                  "data"
                ]
              }
            }
          }
        }
      }
    },
    "/transactions/{transactionId}": {
      "get": {
        "summary": "Get transaction",
        "tags": [
          "transactions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/transactionId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Transaction"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "get-transactions-id",
        "description": "Get transactions-id"
      }
    },
    "/transactions": {
      "post": {
        "summary": "Create transactions",
        "description": "Create transactions if quotation is valid",
        "tags": [
          "transactions"
        ],
        "operationId": "post-transactions",
        "responses": {
          "201": {
            "description": "Transaction is created",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Transaction"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/Transaction"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "transactionId": {
        "name": "transactionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid",
          "example": "271f6d54-9e59-407e-a860-b0771d9e3d26"
        },
        "description": "Transaction id"
      }
    },
    "schemas": {
      "Rate": {
        "title": "Rate",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "271f6d54-9e59-407e-a860-b0771d9e3d26",
                "format": "uuid",
                "readOnly": true
              },
              "type": {
                "type": "string",
                "example": "rates",
                "enum": [
                  "rates"
                ]
              },
              "attributes": {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "rate": {
                    "type": "number",
                    "format": "float",
                    "example": 1.02,
                    "readOnly": true
                  }
                },
                "required": [
                  "rate"
                ]
              },
              "relationships": {
                "type": "object",
                "required": [
                  "fromCurrency",
                  "toCurrency"
                ],
                "properties": {
                  "fromCurrency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  },
                  "toCurrency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "id",
              "type",
              "attributes"
            ]
          }
        ],
        "description": "Rate schema."
      },
      "Quote": {
        "title": "Quote",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "271f6d54-9e59-407e-a860-b0771d9e3d26",
                "format": "uuid",
                "readOnly": true
              },
              "type": {
                "type": "string",
                "example": "quotes",
                "enum": [
                  "quotes"
                ]
              },
              "attributes": {
                "type": "object",
                "properties": {
                  "amount": {
                    "$ref": "#/components/schemas/MoneyAmount"
                  },
                  "tax": {
                    "$ref": "#/components/schemas/MoneyAmount"
                  },
                  "totalMarkups": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/MoneyAmount"
                      }
                    ],
                    "description": "Sum of all markups",
                    "readOnly": true
                  },
                  "serviceMarkup": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/MoneyAmount"
                      }
                    ],
                    "description": "Sum of all markups",
                    "readOnly": true
                  },
                  "totalAmount": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/MoneyAmount"
                      }
                    ],
                    "description": "Sum of amount, total markups and tax(if provided)",
                    "readOnly": true
                  },
                  "feeAmount": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/MoneyAmount"
                      }
                    ],
                    "description": "Company Markup",
                    "readOnly": true
                  },
                  "externalReference": {
                    "type": "string",
                    "example": "FMSXrOAhIOdvIbxAmfSt7vJtRBkurNbn",
                    "description": "A unique session token that ensures rates are locked for the given session"
                  },
                  "feeMultiplier": {
                    "title": "Fee Multiplier",
                    "type": "integer",
                    "example": 3,
                    "minimum": 1
                  }
                },
                "required": [
                  "amount",
                  "totalAmount",
                  "totalMarkups",
                  "serviceMarkup",
                  "feeAmount",
                  "feeMultiplier"
                ]
              },
              "relationships": {
                "type": "object",
                "required": [
                  "fromCurrency",
                  "toCurrency",
                  "payer",
                  "beneficiary"
                ],
                "properties": {
                  "fromCurrency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  },
                  "payer": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CompanyIdentifier"
                      }
                    }
                  },
                  "beneficiary": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CompanyIdentifier"
                      }
                    }
                  },
                  "toCurrency": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CurrencyIdentifier"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "id",
              "type",
              "attributes"
            ]
          }
        ],
        "description": "Quote schema."
      },
      "MoneyAmount": {
        "title": "Money amount",
        "type": "integer",
        "example": 1337,
        "minimum": 0,
        "description": "A positive integer representing an amount of currency defined in the currency's smallest unit. This means that for currencies that have minor units, like EUR, 1 euro would be represented as 100, indicating 100 cents."
      },
      "Money": {
        "title": "Money",
        "description": "Amount and currency.",
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "format": "currency",
            "example": "EUR"
          },
          "amount": {
            "$ref": "#/components/schemas/MoneyAmount"
          }
        },
        "required": [
          "currency",
          "amount"
        ]
      },
      "Transaction": {
        "title": "Transaction",
        "description": "Transaction schema",
        "allOf": [
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "attributes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5",
                "format": "uuid",
                "readOnly": true
              },
              "type": {
                "type": "string",
                "enum": [
                  "transactions"
                ],
                "example": "transactions"
              },
              "attributes": {
                "required": [
                  "externalReference",
                  "createdAt",
                  "amounts",
                  "rates",
                  "paymentMethod",
                  "paymentType"
                ],
                "properties": {
                  "externalReference": {
                    "type": "string",
                    "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5",
                    "format": "uuid",
                    "description": "The UUID related to a specific transaction in our integrating partners DB"
                  },
                  "invoiceReference": {
                    "type": "string",
                    "example": "k1234567890123"
                  },
                  "createdAt": {
                    "type": "string",
                    "example": "2023-01-20T17:04:14+00:00",
                    "format": "date-time",
                    "readOnly": true
                  },
                  "amounts": {
                    "type": "object",
                    "required": [
                      "beneficiary",
                      "quotation",
                      "baseConverted",
                      "salesMargin",
                      "fxMargin",
                      "processingMargin"
                    ],
                    "properties": {
                      "beneficiary": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/Money"
                          }
                        ],
                        "readOnly": true,
                        "description": "This is how much Junction PAY will need to pay out"
                      },
                      "quotation": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/Money"
                          }
                        ],
                        "readOnly": true,
                        "description": "The amount that Junction PAY will be owed."
                      },
                      "baseConverted": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/Money"
                          }
                        ],
                        "readOnly": true,
                        "description": "The amount Junction PAY will need to collect in the payers currency to cover what Junction PAY owes to a beneficiary"
                      },
                      "salesMargin": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/Money"
                          }
                        ],
                        "readOnly": true,
                        "description": "The monetary value of the sales markup for a specific transaction"
                      },
                      "fxMargin": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/Money"
                          }
                        ],
                        "readOnly": true,
                        "description": "The monetary value of the fx markup for a specific transaction for Junction PAY"
                      },
                      "processingMargin": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/Money"
                          }
                        ],
                        "readOnly": true,
                        "description": "The monetary value of the provider markup for a specific transaction"
                      }
                    },
                    "readOnly": true
                  },
                  "rates": {
                    "type": "object",
                    "required": [
                      "fxQuote",
                      "fxBuffer",
                      "salesMarkup",
                      "fxMarkup",
                      "processingMarkup"
                    ],
                    "properties": {
                      "fxQuote": {
                        "type": "number",
                        "format": "float",
                        "example": 1.02,
                        "readOnly": true,
                        "description": "The FX rate Junction PAY provided during the quotation call"
                      },
                      "fxBuffer": {
                        "type": "number",
                        "format": "float",
                        "example": 1.02,
                        "readOnly": true,
                        "description": "The amount  the exchnage rate can move between quotation and transaction before Junction PAY loose money on the trade"
                      },
                      "salesMarkup": {
                        "type": "number",
                        "format": "float",
                        "example": 1.02,
                        "readOnly": true,
                        "description": "The percentage Junction PAY adds as a sales fee"
                      },
                      "fxMarkup": {
                        "type": "number",
                        "format": "float",
                        "example": 1.02,
                        "readOnly": true,
                        "description": "The percentage Junction PAY adds to foreign exchange"
                      },
                      "processingMarkup": {
                        "type": "number",
                        "format": "float",
                        "example": 1.02,
                        "readOnly": true,
                        "description": "The percentage incurred by the business"
                      }
                    },
                    "readOnly": true
                  },
                  "paymentType": {
                    "type": "string",
                    "readOnly": true,
                    "enum": [
                      "unspecified",
                      "card",
                      "bank-transfer"
                    ],
                    "example": "card"
                  },
                  "paymentMethod": {
                    "type": "string",
                    "readOnly": true,
                    "enum": [
                      "unspecified",
                      "transactional",
                      "invoice"
                    ],
                    "example": "transactional"
                  }
                }
              },
              "relationships": {
                "required": [
                  "quotation",
                  "order"
                ],
                "properties": {
                  "quotation": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/QuotationIdentifier"
                      }
                    },
                    "writeOnly": true
                  },
                  "payer": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CompanyIdentifier"
                      }
                    },
                    "readOnly": true,
                    "description": "The ID used to determine who will owe Junction PAY a monetary value"
                  },
                  "beneficiary": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CompanyIdentifier"
                      }
                    },
                    "readOnly": true,
                    "description": "The ID used to determine who Junction PAY owes a monetary value to"
                  },
                  "order": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/OrderIdentifier"
                      }
                    },
                    "writeOnly": true,
                    "description": "The ID used to determine what is the order of the transaction"
                  }
                }
              }
            }
          },
          {
            "$ref": "#/components/schemas/SelfLink"
          }
        ]
      },
      "CompanyIdentifier": {
        "title": "Company Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "04f83af5-10bb-4a0f-1881-03e1e690f0f5",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "companies"
            ],
            "example": "companies"
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "OrderIdentifier": {
        "title": "Order Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "04f83af5-10bb-4a0f-1881-03e1e690f0f5",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "orders"
            ],
            "example": "orders"
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "CurrencyIdentifier": {
        "title": "Currency Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "USD"
          },
          "type": {
            "type": "string",
            "enum": [
              "currencies"
            ],
            "example": "currencies"
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "QuotationIdentifier": {
        "title": "Quotation Identifier",
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5"
          },
          "type": {
            "type": "string",
            "enum": [
              "quotations"
            ],
            "example": "quotations"
          }
        }
      },
      "SelfLink": {
        "title": "Self Link",
        "type": "object",
        "properties": {
          "links": {
            "type": "object",
            "properties": {
              "self": {
                "type": "string",
                "format": "uri",
                "example": "https://example.com/resource/04f83af9-90bb-4a0f-9881-03e1e690f7f5"
              }
            },
            "readOnly": true
          }
        }
      },
      "Error": {
        "title": "Error",
        "type": "object",
        "description": "JSON:API error",
        "properties": {
          "status": {
            "type": "string",
            "pattern": "^[45][0-9]{2}$",
            "description": "The HTTP status code applicable to this problem, expressed as a string value.",
            "example": "404"
          },
          "title": {
            "type": "string",
            "example": "Not Found",
            "description": "A short, human-readable summary of the problem that SHOULD NOT change from occurrence to occurrence of the problem, except for purposes of localization."
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence of the problem. Like `title`, this field’s value can be localized.",
            "example": "Nothing matches the given URI"
          },
          "code": {
            "type": "string",
            "example": "required",
            "description": "An application-specific error code, expressed as a string value."
          },
          "source": {
            "description": "An object containing references to the source of the error.",
            "properties": {
              "pointer": {
                "type": "string",
                "example": "/data/attributes/title",
                "description": "A JSON Pointer to the associated entity in the request document."
              },
              "parameter": {
                "type": "string",
                "example": "page[cursor]",
                "description": "A string indicating which URI query parameter caused the error."
              },
              "header": {
                "type": "string",
                "example": "X-Request-Id",
                "description": "A string indicating the name of a single request header which caused the error."
              }
            },
            "minProperties": 1,
            "maxProperties": 1,
            "type": "object"
          }
        },
        "required": [
          "status",
          "detail"
        ]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/components/schemas/Error"
                  }
