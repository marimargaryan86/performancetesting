    "parameters": {
      "searchId": {
        "name": "searchId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid",
          "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5"
        },
        "description": "Search identifier"
      },
      "page-cursor": {
        "name": "page[cursor]",
        "in": "query",
        "required": false,
        "schema": {
