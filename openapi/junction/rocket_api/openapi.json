  "components": {
    "schemas": {
      "AirSearchRequest": {
        "title": "Air Search Request",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5",
              "readOnly": true
            },
            "type": {
              "type": "string",
              "enum": [
                "air-searches"
              ],
              "example": "air-searches"
            },
            "attributes": {
              "type": "object",
              "required": [
                "criteria",
                "passengers"
              ],
              "properties": {
                "criteria": {
                  "$ref": "#/components/schemas/AirSearchCriteria"
                },
                "passengers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Passenger"
                  }
                }
              }
            }
          },
          "required": [
            "id",
            "type",
            "attributes"
          ],
          "x-examples": {}
      },
      "AirSearchCriteria": {
        "title": "Air Search Criteria",
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "example": "LON"
          },
          "destination": {
            "type": "string",
            "example": "PAR"
          },
          "departureAt": {
            "type": "string",
            "format": "date-time",
            "example": "2019-08-24T14:15:22Z"
          },
          "returnDepartureAt": {
            "type": "string",
            "format": "date-time",
            "example": "2019-08-25T14:15:22Z"
          }
        },
        "required": [
          "origin",
          "destination",
          "departureAt"
        ]
      },
      "Passenger": {
        "title": "Passenger",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Smith"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "2000-01-01"
          }
        },
        "required": [
          "dateOfBirth"
        ]
      },
      "CarRentalSearchIdentifier": {
        "title": "Car Rental Search Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5"
          },
          "type": {
            "type": "string",
            "enum": [
              "car-searches"
            ],
            "example": "car-searches"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "description": "A unique identifier for car rental search."
      },
      "OfferIdentifier": {
        "title": "Offer Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5"
          },
          "type": {
            "type": "string",
            "enum": [
              "offers"
            ],
            "example": "offers"
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "ResultDetailIdentifier": {
        "title": "Result Detail Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5"
          },
          "type": {
            "type": "string",
            "enum": [
              "result-details"
            ],
            "example": "result-details"
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "CarRentalSearchResult": {
        "title": "Car Rental Search Result",
        "type": "object",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5",
                "readOnly": true
              },
              "type": {
                "type": "string",
                "enum": [
                  "search-results"
                ],
                "example": "search-results"
              },
              "attributes": {
                "type": "object",
                "required": [
                  "expiresAt"
                ],
                "properties": {
                  "expiresAt": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2019-08-24T14:15:22Z",
                    "readOnly": true
                  }
                }
              },
              "relationships": {
                "type": "object",
                "required": [
                  "offers",
                  "resultDetails",
                  "search"
                ],
                "properties": {
                  "offers": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/OfferIdentifier"
                        }
                      }
                    }
                  },
                  "resultDetails": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "oneOf": [
                          {
                            "type": "array",
                            "items": {
                              "$ref": "#/components/schemas/ResultDetailIdentifier"
                            }
                          }
                        ]
                      }
                    }
                  },
                  "search": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/CarRentalSearchIdentifier"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "id",
              "type",
              "attributes",
              "relationships"
            ]
          }
        ],
        "description": "Search result representing offer for specified origin and destination."
      },
      "NextLink": {
        "title": "Next Link",
        "type": "object",
        "properties": {
          "links": {
            "type": "object",
            "required": [
              "next"
            ],
            "properties": {
              "next": {
                "type": "string",
                "format": "uri",
                "example": "https://example.com/resource/?page%5Bcursor%5D=MTogIjAwNGNjOTQ5LWQ4NjYtNWM1MS05MmYxLTRjMTUxYTA4YzBjOSIgMjogIjM0ZmQwZmUzMDRhYjY3ZmIiIDM6ICIyZjhiZDU3MDljMjI3Mjg0Ig%3D%3D&page%5Blimit%5D=20",
                "readOnly": true
              }
            },
            "readOnly": true
          }
        },
        "required": [
          "links"
        ]
      },
      "CarRentalSearch": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5",
                "readOnly": true
              },
              "type": {
                "type": "string",
                "enum": [
                  "car-searches"
                ],
                "example": "car-searches"
              },
              "attributes": {
                "type": "object",
                "required": [
                  "driverAge",
                  "expiresAt",
                  "status",
                  "pickupAt",
                  "returnAt",
                  "pickupLocation",
                  "returnLocation"
                ],
                "properties": {
                  "expiresAt": {
                    "type": "string",
                    "format": "date-time",
                    "readOnly": true,
                    "example": "2019-08-24T14:15:22Z"
                  },
                  "status": {
                    "type": "string",
                    "readOnly": true,
                    "enum": [
                      "unspecified",
                      "pending",
                      "processing",
                      "completed",
                      "failed"
                    ],
                    "example": "completed"
                  },
                  "driverAge": {
                    "type": "number",
                    "format": "int32",
                    "example": 32
                  },
                  "pickupAt": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2019-08-24T14:15:22Z"
                  },
                  "returnAt": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2019-08-24T14:15:22Z"
                  },
                  "pickupLocation": {
                    "$ref": "#/components/schemas/Coordinates"
                  },
                  "returnLocation": {
                    "$ref": "#/components/schemas/Coordinates"
                  }
                }
              }
            },
            "required": [
              "id",
              "type",
              "attributes"
            ]
          },
          {
            "$ref": "#/components/schemas/SelfLink"
          }
        ],
        "title": "Car Rental Search",
        "x-examples": {}
      },
      "Coordinates": {
        "title": "Coordinates",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "format": "float",
                "example": 59.858611
              },
              "longitude": {
                "type": "number",
                "format": "float",
                "example": 59.858611
              }
            },
            "required": [
              "latitude",
              "longitude"
            ]
          }
        ],
        "description": "A Coordinate represented via latitude and longitude"
      },
      "Error": {
        "title": "Error",
        "type": "object",
        "description": "JSON:API error",
        "properties": {
          "status": {
            "type": "string",
            "pattern": "^[45][0-9]{2}$",
            "description": "The HTTP status code applicable to this problem, expressed as a string value.",
            "example": "404"
          },
          "title": {
            "type": "string",
            "example": "Not Found",
            "description": "A short, human-readable summary of the problem that SHOULD NOT change from occurrence to occurrence of the problem, except for purposes of localization."
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence of the problem. Like `title`, this field’s value can be localized.",
            "example": "Nothing matches the given URI"
          },
          "code": {
            "type": "string",
            "example": "required",
            "description": "An application-specific error code, expressed as a string value."
          },
          "source": {
            "description": "An object containing references to the source of the error.",
            "properties": {
              "pointer": {
                "type": "string",
                "example": "/data/attributes/title",
                "description": "A JSON Pointer to the associated entity in the request document."
              },
              "parameter": {
                "type": "string",
                "example": "page[cursor]",
                "description": "A string indicating which URI query parameter caused the error."
              },
              "header": {
                "type": "string",
                "example": "X-Request-Id",
                "description": "A string indicating the name of a single request header which caused the error."
              }
            },
            "minProperties": 1,
            "maxProperties": 1,
            "type": "object"
          }
        },
        "required": [
          "status",
          "detail"
        ]
      },
      "SelfLink": {
        "title": "Self Link",
        "type": "object",
        "properties": {
          "links": {
            "type": "object",
            "required": [
              "self"
            ],
            "properties": {
              "self": {
                "type": "string",
                "format": "uri",
                "example": "https://example.com/resource/04f83af9-90bb-4a0f-9881-03e1e690f7f5",
                "readOnly": true
              }
            },
            "readOnly": true
          }
        },
        "required": [
          "links"
        ]
      }
    },
