              "application/vnd.api+json": {
                "schema": {
                  "description": "",
                  "type": "object",
                  "x-examples": {
                    "example-1": {
                      "meta": {
                        "status": "ok"
                      }
                    }
                  },
                  "properties": {
                    "meta": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
