      "LocationIdentifier": {
        "title": "Location Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5"
          },
          "type": {
            "type": "string",
            "example": "locations",
            "enum": [
              "locations"
            ]
          }
        }
      },
      "Location": {
        "title": "Location",
        "allOf": [
          {
            "$ref": "#/components/schemas/LocationIdentifier"
          },
          {
            "type": "object",
            "properties": {
              "attributes": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Stockholm Arlanda Airport"
                  },
                  "latitude": {
                    "type": "number",
                    "format": "float",
                    "example": 59.651164062,
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "format": "float",
                    "example": 17.917829662,
                    "minimum": -180,
                    "maximum": 180
                  },
                  "countryCode": {
                    "type": "string",
                    "format": "country",
                    "example": "SE"
                  },
                  "timeZone": {
                    "type": "string",
                    "example": "Europe/Stockholm"
                  },
                  "iataCode": {
                    "type": "string",
                    "example": "ARN",
                    "pattern": "^[A-Z]{3}$",
                    "minLength": 3,
                    "maxLength": 3,
                    "nullable": true
                  }
                }
              },
              "relationships": {
                "type": "object",
                "properties": {
                  "types": {
                    "type": "object",
                    "properties": {
                      "data": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "$ref": "#/components/schemas/PlaceTypeIdentifier"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "$ref": "#/components/schemas/SelfLink"
          }
        ]
      },
      "LocationFetchable": {
        "title": "Location (Fetch)",
