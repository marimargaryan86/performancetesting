    "/health": {
      "get": {
        "security": [],
        "summary": "Health",
        "tags": [
          "internal"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "description": "",
                  "type": "object",
                  "x-examples": {
                    "example-1": {
                      "meta": {
                        "status": "ok"
                      }
                    }
                  },
                  "properties": {
                    "meta": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "description": "Health status",
                          "enum": [
                            "pass",
                            "fail",
                            "warn"
                          ],
                          "example": "pass"
                        }
                      }
                    }
                  },
                  "required": [
                    "meta"
                  ]
                }
              }
            }
          }
        },
        "operationId": "get-health",
        "description": "Check the application health.",
        "x-internal": true
      }
    },
    "/whatsapp": {
      "post": {
        "security": [],
        "summary": "Create user group",
        "tags": [
          "whatsapp"
        ],
        "operationId": "post-whatsapp",
        "description": "Used from the whatsapp.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string",
                    "example": "body"
                  },
                  "from": {
                    "type": "string",
                    "example": "from"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/register": {
      "post": {
        "security": [],
        "summary": "Register order",
        "tags": [
          "whatsapp"
        ],
        "operationId": "post-register",
        "description": "Used to register an order for plus.",
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/WhatsappRegistration"
                  }
                },
                "required": [
                  "data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/journey-delays": {
      "post": {
        "security": [],
        "summary": "Create fake delay",
        "tags": [
          "whatsapp"
        ],
        "operationId": "post-journey-delays",
        "description": "Used to create a fake delay for a given flight number.",
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/DelayCreation"
                  }
                },
                "required": [
                  "data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
