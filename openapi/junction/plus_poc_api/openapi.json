  "components": {
    "parameters": {},
    "schemas": {
      "WhatsappRegistration": {
        "title": "Whatsapp Registration",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5",
            "readOnly": true
          },
          "type": {
            "type": "string",
            "enum": [
              "whatsapp-registrations"
            ],
            "example": "whatsapp-registrations"
          },
          "attributes": {
            "type": "object",
            "properties": {
            }
          },
          "relationships": {
            "type": "object",
            "properties": {
              "orders": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                      "$ref": "#/components/schemas/OrderIdentifier"
                  }
                }
              }
            },
            "required": [
              "orders"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "attributes",
          "relationships"
        ]
      },
      "DelayCreation": {
        "title": "Delay Creation",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5",
            "readOnly": true
          },
          "type": {
            "type": "string",
            "enum": [
              "journey-delays"
            ],
            "example": "journey-delays"
          },
          "attributes": {
            "type": "object",
            "properties": {
              "flightNumber": {
                "type": "string",
                "example": "A3116"
              },
              "delayMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120,
                "example": 30
              }
            },
            "required": [
              "flightNumber",
              "delayMinutes"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "attributes"
        ]
      },
      "OrderIdentifier": {
        "title": "Order Identifier",
        "description": "",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "04f83af9-90bb-4a0f-9881-03e1e690f7f5"
          },
          "type": {
            "type": "string",
            "enum": [
              "orders"
            ],
            "example": "orders"
          }
        },
        "required": [
          "id",
          "type"
        ]
      }
    },
    "responses": {},
