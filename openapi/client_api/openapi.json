                  "properties": {
                    "data": {
                      "type": "array",
                      "uniqueItems": true,
                      "minItems": 0,
                      "items": {
                        "$ref": "#/components/schemas/PlaceResource"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                },
                "examples": {}
              }
            }
          }
        },
        "operationId": "get-places",
