    "/journeys/searches": {
      "post": {
        "summary": "New Journey Search",
        "tags": [
          "journeys"
        ],
        "operationId": "post-journeys-searches",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/JourneySearchResource"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "description": "Make a new journey search.",
        "requestBody": {
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/JourneySearchResource"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/journeys/searches/{journeySearchId}": {
      "parameters": [
        {
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "name": "journeySearchId",
          "description": "JourneySearch resource identifier",
          "in": "path",
          "required": true
        }
      ],
      "get": {
        "summary": "View Journey Search",
        "tags": [
          "journeys"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/JourneySearchResource"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "get-journeys-searches-journey-search-id",
        "description": "View a previously created journey search."
      }
    },
    "/journeys/searches/{journeySearchId}/journeys": {
      "parameters": [
        {
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "name": "journeySearchId",
          "in": "path",
          "required": true,
          "description": "JourneySearch resource identifier"
        }
      ],
      "get": {
        "summary": "List Journeys",
        "tags": [
          "journeys"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "uniqueItems": true,
                      "minItems": 0,
                      "items": {
                        "$ref": "#/components/schemas/JourneyResource"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "get-journeys-searches-journey-search-id-journeys",
        "description": "View journeys for a journey search."
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "tags": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "description": "",
                  "type": "object",
                  "x-examples": {
                    "example-1": {
                      "meta": {
                        "status": "ok"
                      }
                    }
                  },
                  "properties": {
                    "meta": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Health status",
                          "enum": [
                            "ok"
                          ]
                        }
                      }
                    }
                  },
                  "required": [
                    "meta"
                  ]
                }
              }
            }
          }
        },
        "operationId": "get-health",
        "description": "Check the application health."
      }
    }
  },
  "components": {
    "schemas": {
      "PlaceResource": {
        "title": "Place Resource",
        "allOf": [
          {
            "$ref": "#/components/schemas/PlaceResourceIdentifier"
          },
          {
            "type": "object",
            "properties": {
              "attributes": {
                "type": "object"
              }
            },
            "required": [
              "attributes"
            ]
          },
          {
            "$ref": "#/components/schemas/SelfLink"
          }
        ]
      },
      "PlaceResourceIdentifier": {
        "title": "Place Resource Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "places"
            ]
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "JourneyResource": {
        "title": "JourneyResource",
        "allOf": [
          {
            "$ref": "#/components/schemas/JourneyResourceIdentifier"
          },
          {
            "type": "object",
            "properties": {
              "attributes": {
                "type": "object"
              }
            }
          }
        ]
      },
      "JourneyResourceIdentifier": {
        "title": "JourneyResourceIdentifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "journeys"
            ]
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "JourneySearchResource": {
        "allOf": [
          {
            "$ref": "#/components/schemas/JourneySearchResourceIdentifier"
          },
          {
            "type": "object",
            "properties": {
              "attributes": {
                "type": "object",
                "required": [
                  "expiresAt"
                ],
                "properties": {
                  "expiresAt": {
                    "type": "string",
                    "format": "date-time",
                    "readOnly": true
                  },
                  "departureAfter": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "relationships": {
                "type": "object",
                "required": [
                  "origin",
                  "destination"
                ],
                "properties": {
                  "origin": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/PlaceResourceIdentifier"
                      }
                    }
                  },
                  "destination": {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/PlaceResourceIdentifier"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "relationships"
            ]
          },
          {
            "$ref": "#/components/schemas/SelfLink"
          }
        ]
      },
      "JourneySearchResourceIdentifier": {
        "title": "Journey Search Resource Identifier",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "journey-searches"
            ]
          }
        }
      },
      "Error": {
        "title": "Error",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "pattern": "^[45][0-9]{2}$",
            "description": "The HTTP status code generated by the origin server for this occurrence of the problem.",
            "example": "404"
          },
          "title": {
            "type": "string",
            "example": "Not Found",
            "description": "A short, summary of the problem type. Written in english and readable for engineers (usually not suited for non technical stakeholders and not localized)."
          },
          "detail": {
            "type": "string",
            "description": "A human readable explanation specific to this occurrence of the problem.",
            "example": "Nothing matches the given URI"
          }
        },
        "required": [
          "status",
          "title",
          "detail"
        ],
        "description": "JSON:API error"
      },
      "SelfLink": {
        "title": "SelfLink",
        "type": "object",
        "properties": {
          "links": {
            "required": [
              "self"
            ],
            "type": "object",
            "properties": {
              "self": {
                "type": "string",
                "readOnly": true
              }
            },
            "readOnly": true
          }
        },
        "required": [
          "links"
        ]
      }
    },
    "responses": {
      "NotFound": {
        "description": "Not Found",
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "required": [
                "errors"
              ]
            }
          }
        }
      },
      "BadRequest": {
        "description": "Bad Request",
        "content": {
          "application/vnd.api+json": {
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 1,
                  "items": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "required": [
                "errors"
              ]
            }
          }
        }
      }
    }
  }
}